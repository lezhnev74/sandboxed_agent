{
  "argv": [
    "claude",
    "-p",
    "--model",
    "opus",
    "--dangerously-skip-permissions",
    "--output-format",
    "stream-json",
    "--verbose",
    "--setting-sources",
    "user",
    "--strict-mcp-config",
    "--add-dir",
    "/srv/data",
    "--add-dir",
    "/home/u/repo/.git",
    "--mcp-config",
    "/cfg/repo-1234/20260929-120000-abcd/bundle/mcp.json",
    "--append-system-prompt-file",
    "/cfg/repo-1234/20260929-120000-abcd/bundle/system.md",
    "--effort",
    "high"
  ],
  "env": [
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1",
    "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=1",
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS=1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
    "CLAUDE_CONFIG_DIR=/cfg/repo-1234/20260929-120000-abcd/claude",
    "DISABLE_AUTOUPDATER=1"
  ],
  "stdin": "/cfg/repo-1234/20260929-120000-abcd/bundle/prompt.md",
  "files": [
    {
      "path": "/cfg/repo-1234/20260929-120000-abcd/claude/settings.json",
      "data": "{\"skipDangerousModePermissionPrompt\":true}\n"
    },
    {
      "path": "/cfg/repo-1234/20260929-120000-abcd/claude/.claude.json",
      "data": "{\"hasCompletedOnboarding\":true,\"bypassPermissionsModeAccepted\":true}\n"
    }
  ],
  "copies": [
    {
      "from": "/cfg/repo-1234/20260929-120000-abcd/bundle/skills",
      "to": "/cfg/repo-1234/20260929-120000-abcd/claude/skills"
    },
    {
      "from": "/cfg/repo-1234/20260929-120000-abcd/bundle/agents",
      "to": "/cfg/repo-1234/20260929-120000-abcd/claude/agents"
    }
  ]
}
